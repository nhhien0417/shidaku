# Cloudflare Pages headers.
#
# The load budget (<= 3s to interactive on 4G) depends on these being right, so they are part
# of the product, not deployment trivia.

# Hashed filenames never change contents - cache them for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Puzzles change only when content is re-authored. An hour keeps a same-day content fix cheap
# without refetching them every session.
/puzzles/*
  Cache-Control: public, max-age=3600

# index.html must never be stale: it is what points at the hashed bundle, and a cached copy
# would pin returning visitors to an old build - which would silently mix two build_ver
# values into one funnel.
/index.html
  Cache-Control: no-cache

/
  Cache-Control: no-cache

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
